# ==============================================================================
# MP_Mix_Manager_v0.2 - Environment & Configuration File
# Copy this file to 'config.env' to customize paths and settings.
# ==============================================================================

# Root directory of your music and mix archive.
# Auto-detected defaults across platforms:
#   Linux:   /run/media/$USER/WD BLACK B/MIX_ARCHIVE
#   macOS:   /Volumes/WD BLACK B/MIX_ARCHIVE or /Volumes/MIX_ARCHIVE
#   Windows: D:/MIX_ARCHIVE or /d/MIX_ARCHIVE
# MIX_ARCHIVE_DIR="/run/media/$USER/WD BLACK B/MIX_ARCHIVE"
# MIX_ARCHIVE_DIR="/Volumes/WD BLACK B/MIX_ARCHIVE"
# MIX_ARCHIVE_DIR="D:/MIX_ARCHIVE"

# Output directory for converted FLAC files (relative to MIX_ARCHIVE_DIR or absolute)
OUTPUT_DIR="FLAC_CONVERTED_OUTPUTS"

# Archive directory for converted WAV source files
ARCHIVE_DIR="CONVERTED_WAV_FILES"

# Spek spectrogram output directory
SPEK_DIR="SPEK_OUTPUTS"

# Traktor Pro History XML directory for automatic tracklist extraction
# Auto-detected across platforms:
#   Linux:   /run/media/$USER/WD BLACK B/MIX_ARCHIVE/Traktor 3.11.1/History
#   macOS:   /Volumes/WD BLACK B/MIX_ARCHIVE/Traktor 3.11.1/History or $HOME/Documents/Native Instruments/Traktor 3.11.1/History
#   Windows: D:/MIX_ARCHIVE/Traktor 3.11.1/History or C:/Users/$USER/Documents/Native Instruments/Traktor 3.11.1/History
# TRAKTOR_HISTORY_DIR="/run/media/$USER/WD BLACK B/MIX_ARCHIVE/Traktor 3.11.1/History"

# Google Drive remote name and path configured in rclone
GDRIVE_REMOTE="gdrive:MIX_ARCHIVE/FLAC_CONVERTED_OUTPUTS"

# NFT Videos directory for playlist generation
# NFT_VIDEOS_DIR="/run/media/$USER/DATA/NFT_VIDEOS"

# WAN2GP AI Video Generator directory (if installed)
# WAN2GP_DIR="$HOME/pinokio/api/wan.git/app"
# WAN2GP_OUTPUTS="$HOME/Documents/WAN2GP_OUTPUTS"

# Default Audio Player for playback and startup auto-play
# Options: strawberry, cliamp, vlc, haruna, kodi, mpv, audacity
DEFAULT_AUDIO_PLAYER="strawberry"

# Startup Autoplay Settings
# Set to "true" to automatically play a mix when the manager starts up
AUTO_PLAY_ON_STARTUP="true"

# Automatically open and display cover art on startup
AUTO_SHOW_COVER_ON_STARTUP="true"

# Automatically display matching tracklist on startup
AUTO_SHOW_TRACKLIST_ON_STARTUP="true"

# Default Tracklist Viewer (opens tracklist in a dedicated new window on boot)
# Options: console (default: OS default console / borderless terminal on Bazzite Linux), auto (external GUI editor), kwrite, kate, gedit, mousepad, konsole, xdg-open
TRACKLIST_VIEWER="console"

# Startup Mix Selection Mode: "latest" (newest mix), "random", or specific mix filename/keyword
AUTO_PLAY_MIX_SELECTION="latest"

# ==============================================================================
# Promotional & Publisher Outreach Email Settings
# ==============================================================================
# Senders information
PROMO_SENDER_NAME="MPlanetarian"
# PROMO_SENDER_EMAIL="artist@example.com"
# PROMO_REPLY_TO="artist@example.com"

# Outgoing SMTP Server (e.g., Gmail, Outlook, AWS SES, or Custom Mailserver)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="artist@example.com"
# SMTP_PASSWORD="" # Optional app password (can also be entered interactively)
# SMTP_USE_TLS="true"
# SMTP_USE_SSL="false"

# Default Promo & Streaming URLs
# PROMO_PODCAST_URL="https://podcasts.apple.com/..."
# PROMO_SOUNDCLOUD_URL="https://soundcloud.com/mplanetarian"
# PROMO_YOUTUBE_URL="https://youtube.com/@mplanetarian"
# PROMO_MIXCLOUD_URL="https://mixcloud.com/mplanetarian"
# PROMO_WEBSITE_URL="https://mplanetarian.com"

# ==============================================================================
# Universal Search & Import Mixes Settings (Local Drives & SMB)
# ==============================================================================
# Minimum file size in MB to qualify as a full mix (default: 100)
# SEARCH_IMPORT_MIN_SIZE_MB="100"

# Preferred default SMB host / share for mix ingest
# SMB_DEFAULT_HOST="192.168.1.138"

# Automatically prompt or run FLAC conversion after importing new WAV mixes
# AUTO_CONVERT_AFTER_IMPORT="true"

# ==============================================================================
# Video Player & Startup Custom YouTube Video Settings
# ==============================================================================
# Default Video Player for mix companion videos and visual playback
# Options: vlc, mpv, haruna, kodi
DEFAULT_VIDEO_PLAYER="vlc"

# Custom YouTube video URL to play on manager startup (e.g. ambient visualizer)
# Plays only if a mix is playing already in a music player
AUTO_PLAY_YOUTUBE_ON_STARTUP="false"
STARTUP_YOUTUBE_URL=""

# ==============================================================================
# Meteorological / Live Weather Settings
# ==============================================================================
# Display current weather below the startup banner
WEATHER_ENABLED="true"

# Weather location (e.g., Swansea, UK or London, UK)
WEATHER_LOCATION="Swansea, UK"


